{
  "name": "trailon-aiguide",
  "version": "0.1.0",
  "description": "TrailOn AI guide microservice",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "rag:index": "nest build && node dist/rag/rag-index.cli.js",
    "d1:migrate": "node scripts/apply-d1-migration.mjs",
    "test:conversation": "nest build && node --test src/conversation/conversation-history.helpers.test.mjs",
    "test:guide-links": "nest build && node --test src/guide/guide-blog-links.test.mjs",
    "test:library-routes": "nest build && node --test src/guide/library-routes.test.mjs",
    "test:conversation:d1": "node scripts/conversation-d1-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "openai": "^7.53.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
